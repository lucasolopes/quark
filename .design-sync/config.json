{
  "projectId": "3bc342d5-c773-4c3e-8c21-510883814d2e",
  "shape": "package",
  "readmeHeader": ".design-sync/conventions.md",
  "pkg": "web",
  "globalName": "Quark",
  "entry": "web/ds-entry.ts",
  "tsconfig": "../.design-sync/tsconfig.dsync.json",
  "buildCmd": "cd web && npx -y @tailwindcss/cli@4.3.3 -i .ds-css/entry.css -o .ds-css/ds.css",
  "cssEntry": ".ds-css/ds.css",
  "extraFonts": [
    "node_modules/@fontsource-variable/hanken-grotesk/index.css",
    "node_modules/@fontsource-variable/space-grotesk/index.css",
    "node_modules/@fontsource-variable/jetbrains-mono/index.css",
    "../.design-sync/fonts-fallback.css"
  ],
  "extraEntries": ["../.design-sync/preview-support.tsx"],
  "provider": { "component": "PreviewProviders" },
  "overrides": {
    "StatCard": { "cardMode": "column" },
    "Card": { "cardMode": "column" },
    "Input": { "cardMode": "column" },
    "Label": { "cardMode": "column" },
    "MeterBar": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Dialog": { "cardMode": "single", "viewport": "640x480" },
    "AlertDialog": { "cardMode": "single", "viewport": "640x420" },
    "DropdownMenu": { "cardMode": "single", "viewport": "420x340" },
    "Toaster": { "cardMode": "single", "viewport": "520x320" },
    "Table": { "cardMode": "column" },
    "PageHeader": { "cardMode": "column" },
    "Terminal": { "cardMode": "single", "viewport": "640x360" }
  },
  "componentSrcMap": {
    "Button": "src/components/ui/button.tsx",
    "Badge": "src/components/ui/badge.tsx",
    "Card": "src/components/ui/card.tsx",
    "Checkbox": "src/components/ui/checkbox.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "AlertDialog": "src/components/ui/alert-dialog.tsx",
    "DropdownMenu": "src/components/ui/dropdown-menu.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/label.tsx",
    "Skeleton": "src/components/ui/skeleton.tsx",
    "Switch": "src/components/ui/switch.tsx",
    "Table": "src/components/ui/table.tsx",
    "Tabs": "src/components/ui/tabs.tsx",
    "Textarea": "src/components/ui/textarea.tsx",
    "Toaster": "src/components/ui/sonner.tsx",
    "QuarkMark": "src/components/brand/QuarkMark.tsx",
    "CollapsibleSection": "src/components/CollapsibleSection.tsx",
    "Combobox": "src/components/Combobox.tsx",
    "CreateLinkDialog": "src/components/CreateLinkDialog.tsx",
    "CreateTokenDialog": "src/components/CreateTokenDialog.tsx",
    "CreateWorkspaceForm": "src/components/CreateWorkspaceForm.tsx",
    "DurationField": "src/components/DurationField.tsx",
    "EditLinkDialog": "src/components/EditLinkDialog.tsx",
    "LanguageSwitcher": "src/components/LanguageSwitcher.tsx",
    "LinkQrDialog": "src/components/LinkQrDialog.tsx",
    "LinkTable": "src/components/LinkTable.tsx",
    "MeterBar": "src/components/MeterBar.tsx",
    "MobileNav": "src/components/MobileNav.tsx",
    "OutOfShellFrame": "src/components/OutOfShellFrame.tsx",
    "PageHeader": "src/components/PageHeader.tsx",
    "RecentEventsTable": "src/components/RecentEventsTable.tsx",
    "RulesEditor": "src/components/RulesEditor.tsx",
    "StatCard": "src/components/StatCard.tsx",
    "StatsCharts": "src/components/StatsCharts.tsx",
    "StatsView": "src/components/StatsView.tsx",
    "Terminal": "src/components/Terminal.tsx",
    "TtlChips": "src/components/TtlChips.tsx",
    "VariantsEditor": "src/components/VariantsEditor.tsx"
  }
}
